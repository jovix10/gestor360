# MongoDB Atlas — string de conexão (obrigatório)
MONGO_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# Nome do banco (obrigatório)
DB_NAME=gestor360

# Segredo do JWT — troque por uma string longa aleatória
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Domínio autorizado do frontend em produção (Vercel)
# Ex.: https://gestor360.vercel.app
FRONTEND_URL=https://seu-app.vercel.app

# Porta do servidor (o Render define automaticamente; local usa 8001)
PORT=8001
